{
    servers {
        # Cloudflare's published ranges. Caddy needs these to read the real
        # client address out of X-Forwarded-For instead of recording every
        # request as coming from the edge. This list is only trustworthy
        # because the Vultr firewall admits nothing else on 80/443 -- trusting
        # a header from an open origin is trusting the header's author.
        trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
    }
}

# Anything arriving with a Host this server does not serve is refused before it
# reaches Langfuse: a scan of the origin address gets a closed connection
# rather than a login page.
:80, :443 {
    abort
}

<{ langfuse-host }> {
    encode zstd gzip

    # Ingestion batches carry whole prompts and completions; the default
    # would truncate a large SDK flush into a 413 the SDK retries forever.
    request_body max_size 64MB

    log {
        output stdout
        format json
    }

    reverse_proxy langfuse-web:3000 {
        transport http {
            read_timeout 300s
            write_timeout 300s
        }
    }

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }
}
