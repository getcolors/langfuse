{:paths ["src/clj" "src/resources"]
 :deps {org.clojure/clojure       {:mvn/version "1.12.5"}
        io.github.getcolors/green {:git/url "https://github.com/getcolors/green.git"
                                   :git/sha "ceb4159a19ec281d60f10d11295c05c5de5f1c42"}
        ;; bc06f2f is where ONCE moved the machine keypair into the operator's
        ;; ~/.ssh; this package's SSH behaviour is that namespace, so the pin
        ;; cannot go below it.
        io.github.getcolors/once  {:git/url "https://github.com/getcolors/once.git"
                                   :git/sha "759eb0311b4bdf881eab813cfe5d00f76b9310cc"
                                   :deps/root "green"}
        ;; The whole storage tier. This package renders neon's Ansible
        ;; templates straight off the classpath -- deps.edn there publishes
        ;; src/resources, so `compose.yml`, `main.yml`, `pageserver.toml`,
        ;; `identity.toml`, `config.json`, `scramgen.py` and the
        ;; bootstrap/rotate/smoke/status scripts arrive as namespaced keyword
        ;; resources and are never copied here. A copy of a tier this subtle
        ;; drifts, and the drift is silent.
        ;;
        ;; 87c0095 is the commit n8n-vultr verified live on 2026-09-01.
        io.github.getcolors/neon  {:git/url "https://github.com/getcolors/neon.git"
                                   :git/sha "87c009549a928fdf1f9dc135f9740c3baa5782d7"
                                   :deps/root "green"}}
 :aliases {:dev {:extra-paths ["test/clj" "test/resources"]}
           :test {:extra-paths ["test/clj" "test/resources"]
                  :extra-deps {io.github.cognitect-labs/test-runner
                               {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
                  :exec-fn cognitect.test-runner.api/test}}}
