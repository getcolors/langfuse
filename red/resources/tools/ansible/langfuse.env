# Rendered non-secrets for langfuse-web and langfuse-worker. Every address is
# a VPC address from the inventory; every credential is in host.env or
# operator.env instead.
NEXTAUTH_URL=https://<{ langfuse-host }>
HOSTNAME=0.0.0.0
TELEMETRY_ENABLED=false
LANGFUSE_ENABLE_EXPERIMENTAL_FEATURES=false
LANGFUSE_CSP_ENFORCE_HTTPS=true
LANGFUSE_LOG_LEVEL=info

# Postgres: the host and database are here, the role password is in
# DATABASE_URL in host.env, which wins because it is listed later.

# ClickHouse, node 0. Langfuse has no client-side replica failover; the data
# lives on all three, the app tier reaches one. Cluster mode on, because the
# bundled migrations run ON CLUSTER default.
CLICKHOUSE_URL=http://{{ ch0_vpc_ip }}:<{ clickhouse-http-port }>
CLICKHOUSE_MIGRATION_URL=clickhouse://{{ ch0_vpc_ip }}:<{ clickhouse-native-port }>
CLICKHOUSE_USER=langfuse
CLICKHOUSE_DB=default
CLICKHOUSE_CLUSTER_ENABLED=true

REDIS_HOST={{ redis_vpc_ip }}
REDIS_PORT=<{ redis-port }>

# Raw events, media and batch exports in R2: one bucket, three prefixes, all
# profile-scoped. Region auto and the account endpoint are what R2 wants; no
# path-style flag.
LANGFUSE_S3_EVENT_UPLOAD_BUCKET=<{ langfuse-s3-bucket }>
LANGFUSE_S3_EVENT_UPLOAD_REGION=<{ neon-r2-region }>
LANGFUSE_S3_EVENT_UPLOAD_ENDPOINT=<{ neon-r2-endpoint }>
LANGFUSE_S3_EVENT_UPLOAD_PREFIX=<{ langfuse-s3-prefix }>events/
LANGFUSE_S3_MEDIA_UPLOAD_BUCKET=<{ langfuse-s3-bucket }>
LANGFUSE_S3_MEDIA_UPLOAD_REGION=<{ neon-r2-region }>
LANGFUSE_S3_MEDIA_UPLOAD_ENDPOINT=<{ neon-r2-endpoint }>
LANGFUSE_S3_MEDIA_UPLOAD_PREFIX=<{ langfuse-s3-prefix }>media/
LANGFUSE_S3_BATCH_EXPORT_ENABLED=true
LANGFUSE_S3_BATCH_EXPORT_BUCKET=<{ langfuse-s3-bucket }>
LANGFUSE_S3_BATCH_EXPORT_REGION=<{ neon-r2-region }>
LANGFUSE_S3_BATCH_EXPORT_ENDPOINT=<{ neon-r2-endpoint }>
LANGFUSE_S3_BATCH_EXPORT_PREFIX=<{ langfuse-s3-prefix }>exports/

# Headless initialization: created on first boot if absent, never changed
# afterwards. The password is in operator.env; the project keys in host.env.
LANGFUSE_INIT_ORG_ID=<{ langfuse-init-org-id }>
LANGFUSE_INIT_ORG_NAME=<{ langfuse-init-org-name }>
LANGFUSE_INIT_PROJECT_ID=<{ langfuse-init-project-id }>
LANGFUSE_INIT_PROJECT_NAME=<{ langfuse-init-project-name }>
LANGFUSE_INIT_USER_EMAIL=<{ langfuse-init-user-email }>
LANGFUSE_INIT_USER_NAME=<{ langfuse-init-user-name }>
