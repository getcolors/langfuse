import os
import subprocess
import sys

UNPINNED_ERROR = """\
this launcher carries no langfuse pin.
It has not been stamped by `bb pin`, which cannot run until the langfuse
repository has been pushed.
Point it at a checkout meanwhile: LANGFUSE_LIB_ROOT=/path/to/langfuse (the repository root)
