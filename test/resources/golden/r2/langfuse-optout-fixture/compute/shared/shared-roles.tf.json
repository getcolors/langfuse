  "output": {
    "params": {
      "value": {
        "network_cidr": "${vultr_vpc.network.v4_subnet}/${vultr_vpc.network.v4_subnet_mask}",
        "provider": "vultr",
        "role_firewall_ids": "${ { for role, firewall in vultr_firewall_group.role : role => firewall.id } }",
        "vpc_id": "${vultr_vpc.network.id}",
        "vpc_ip_range": "10.50.0.0/24"
      }
    }
  },
  "provider": {
    "vultr": {}
  },
  "resource": {
    "vultr_firewall_group": {
      "role": {
        "description": "${each.value}",
        "for_each": {
          "app": "langfuse-optout-fixture-app-firewall",
          "clickhouse": "langfuse-optout-fixture-clickhouse-firewall",
          "neon": "langfuse-optout-fixture-neon-firewall",
          "redis": "langfuse-optout-fixture-redis-firewall"
        },
        "lifecycle": {
          "prevent_destroy": true
        }
      }
    },
    "vultr_firewall_rule": {
      "ingress": {
        "firewall_group_id": "${vultr_firewall_group.role[each.value.role].id}",
        "for_each": "${local.ingress}",
        "ip_type": "${each.value.ip_type}",
        "port": "${each.value.port}",
        "protocol": "${each.value.protocol}",
        "subnet": "${each.value.subnet}",
        "subnet_size": "${each.value.subnet_size}"
      }
    },
    "vultr_vpc": {
      "network": {
        "description": "langfuse-optout-fixture",
        "lifecycle": {
          "prevent_destroy": true
        },
        "region": "ams",
        "v4_subnet": "10.50.0.0",
        "v4_subnet_mask": 24
      }
    }
  },
  "terraform": {
    "required_providers": {
      "vultr": {
        "source": "vultr/vultr",
        "version": "2.32.0"
      }
    }
  }
}
